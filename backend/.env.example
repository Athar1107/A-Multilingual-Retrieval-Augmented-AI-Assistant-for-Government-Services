# ============================================================
# Seva AI — Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# === MODEL CACHING ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === TRANSLATION ===
# HF_TOKEN enables IndicTrans2 (native gom_Deva). Get one at huggingface.co/settings/tokens
HF_TOKEN=
TRANSLATION_MODEL=auto
USE_RETRIEVAL_HINTS=false

# === APPLICATION ===
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# === SECURITY ===
API_KEY=dev-secret-key-123
API_KEY_HEADER=X-API-Key
ADMIN_USERNAME=Atharv
ADMIN_API_KEY=admin@1234
QUERY_LOG_DB_PATH=./data/query_log.db
ADMIN_RATE_LIMIT_PER_MINUTE=60

# === LLM (Ollama) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === RAG PIPELINE ===
TOP_K=5
CONFIDENCE_THRESHOLD=0.50
CHUNK_SIZE_WORDS=300
CHROMA_INDEX_PATH=./data/indexes/chroma
PROCESSED_CORPUS_PATH=./data/processed/active_english.json

# === RATE LIMITING ===
RATE_LIMIT_CHAT_PER_MINUTE=20

# === CORS ===
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
