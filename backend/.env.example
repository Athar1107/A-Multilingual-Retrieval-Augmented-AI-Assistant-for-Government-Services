# ============================================================
# Government AI Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# === MODEL CACHING (set to 1 after models are downloaded to avoid slow HF Hub checks) ===
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# === TRANSLATION ===
# HF_TOKEN enables IndicTrans2 (native kok_Deva). Get one at huggingface.co/settings/tokens
# Also requires manual access approval at:
#   https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
#   https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
HF_TOKEN=

# TRANSLATION_MODEL: "auto" (default) | "indictrans2" | "nllb" | "none"
# auto = use IndicTrans2 if HF_TOKEN set, else NLLB-200 (Marathi proxy for Konkani)
# nllb = force NLLB-200 regardless of HF_TOKEN (ungated, ~600 MB)
# none = disable translation entirely (English queries only)
TRANSLATION_MODEL=auto

# === APPLICATION ===
APP_ENV=development
# Options: development | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# === SECURITY ===
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=
API_KEY_HEADER=X-API-Key
ADMIN_KEY_HEADER=X-Admin-Key

# === DATABASE ===
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/gov_ai.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/gov_ai

# === CHROMADB ===
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
# Optional ChromaDB server auth token (leave blank for local dev):
CHROMA_AUTH_TOKEN=

# === LLM (Ollama) ===
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
LLM_MODEL=llama3.1:8b
# Use llama3.1:70b for production (requires GPU with >= 40GB VRAM)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_CONTEXT_WINDOW=8192
LLM_STREAMING=true

# === EMBEDDING SERVICE ===
EMBEDDING_SERVICE_HOST=embedding
EMBEDDING_SERVICE_PORT=8002
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=1024

# === RAG PIPELINE ===
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=600
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSION_TOP_K=10
RERANKER_TOP_N=5
MIN_RERANK_SCORE=0.5
MIN_VECTOR_SCORE=0.3
MAX_HISTORY_TURNS=3

# === RATE LIMITING ===
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_SOURCES_PER_MINUTE=60
RATE_LIMIT_FEEDBACK_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# === CORS ===
# Comma-separated list of allowed origins
# Production is served on one origin by nginx. Add only explicit development origins.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# === INGESTION ===
INGESTION_BATCH_SIZE=10
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=pdf,html,htm,txt,json
ENABLE_DEDUP=true
